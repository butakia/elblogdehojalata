# Copia este archivo a .env.local para desarrollo. En Vercel se cargan desde Settings > Environment Variables.

# Clave para entrar al panel (/admin). OBLIGATORIA en producción.
ADMIN_PASSWORD=

# Opcional: texto secreto extra para firmar la sesión del panel.
ADMIN_SECRET=

# Redis (Upstash): textos, ideas y comentarios. Vercel los crea al conectar la base.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (también funcionan KV_REST_API_URL y KV_REST_API_TOKEN)

# Vercel Blob: imágenes subidas desde el panel. Vercel lo crea al conectar el Blob.
BLOB_READ_WRITE_TOKEN=

# Opcional: dirección pública si usas dominio propio (para las vistas previas al compartir).
NEXT_PUBLIC_SITE_URL=
